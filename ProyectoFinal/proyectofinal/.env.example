# Copiar a .env (o exportar como variables de entorno reales) y completar.
# Ninguna de estas variables es leída automáticamente de un archivo .env:
# el proyecto no usa python-dotenv, así que hay que exportarlas en el
# entorno donde corra Django (systemd, Heroku config vars, etc.).

DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=tu-dominio.cl

# DB_ENGINE=django.db.backends.sqlite3 sirve para correr `manage.py test`
# o desarrollo local sin tener MySQL instalado (en ese caso DB_NAME debe
# ser una ruta de archivo, ej: DB_NAME=db.sqlite3, y USER/PASSWORD/HOST/
# PORT se ignoran).
DB_ENGINE=django.db.backends.mysql
DB_NAME=proyecto
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

TRANSBANK_COMMERCE_CODE=
TRANSBANK_API_KEY=
TRANSBANK_ENVIRONMENT=INTEGRATION

# Activar solo cuando el sitio esté servido detrás de HTTPS real
DJANGO_USE_HTTPS=False
